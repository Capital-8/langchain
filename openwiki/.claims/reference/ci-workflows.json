    {
      "id": "claim_6037635808924cb2901b0ccc4f0607c5",
      "statement": "The build job in check_diffs.yml analyzes changed files and generates dynamic test matrices through check_diff.py, which maps file changes to affected packages, builds dependency graphs from pyproject.toml and extended_testing_deps.txt, cascades changes through dependents, and treats infrastructure changes to .github/* and CI scripts conservatively by triggering extended tests on all core packages.",
      "evidence": [
        {
