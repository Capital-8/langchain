    {
      "id": "claim_c1d6f70cda0643ccb05317c0f9f2d663",
      "statement": "LangChain uses pytest markers to classify integration tests into three categories: @pytest.mark.vcr for cassette-backed tests using recorded HTTP interactions, @pytest.mark.scheduled for live API tests run in scheduled daily workflows, and unmarked tests for offline unit-like tests without API calls.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/integration_tests.yml",
          "version": "repo-file-v1:sha256:0478384dba190d090d7d497c18b607ab68519e95ec37e2137e43d995a13b3409"
        },
        {
