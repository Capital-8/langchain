          "version": "repo-file-v1:sha256:f6f971c5c6be3c9c40e635b5af66a08bd58aac8b6fcf353caf300441864bcace"
        }
      ]
    },
    {
      "id": "claim_8362b25c75d148f2938dbd4791868b3a",
      "statement": "The langchain-tests package provides standard test base classes (ChatModelIntegrationTests, EmbeddingsIntegrationTests, VectorStoreIntegrationTests, RetrieversIntegrationTests, ToolsIntegrationTests, BaseStoreSyncTests, SyncCacheTestSuite) that subclasses implement by providing required properties and fixtures. All inherit from BaseStandardTests, which enforces that test overrides must use @pytest.mark.xfail(reason='...') to prevent accidental test deletion.",
      "evidence": [
        {
          "resource": "repo://libs/standard-tests/langchain_tests/base.py#L4-L45",
