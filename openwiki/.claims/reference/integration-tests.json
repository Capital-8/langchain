          "version": "repo-lines-v1:sha256:60ef5c509366e68513c1c76adb2460f7c6198a4a5f7759abba35cfc95fdcd834:"
        }
      ]
    },
    {
      "id": "claim_7cab904930ff40cda20f37e4456e28af",
      "statement": "SandboxBackendProtocol upload_files() accepts list[(path, bytes)] and returns FileUploadResponse list preserving input order. download_files() accepts path list and returns FileDownloadResponse list with content, error handling for missing files/directories/permissions, and 10 MiB+ file support. Relative paths return invalid_path error; missing parent directories may be auto-created or error depending on implementation.",
      "evidence": [
