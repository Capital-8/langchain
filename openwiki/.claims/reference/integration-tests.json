          "resource": "repo://libs/standard-tests/langchain_tests/integration_tests/sandboxes.py#L377-L520",
          "version": "repo-lines-v1:sha256:52ae017049c8224f0c2300eeb227173c89369d2494469d6701d583fdfb058c16:"
